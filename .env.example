# Copy to .env.local and fill in. Never commit .env.local.

# Required. Free tier key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Everything below is optional; defaults shown ---

# GEMINI_MODEL=gemini-2.5-flash

# Upload limits.
# MAX_PAGES_PER_DOCUMENT=20
# MAX_PAGE_BYTES=8388608
# MAX_PAGE_PIXELS=40000000

# Model call budget. Free tiers are rate limited per minute, so raising
# concurrency is the quickest way to start getting 429s.
# AI_CONCURRENCY=2
# AI_MAX_RETRIES=2

# Response cache, keyed by model + prompt + page bytes. Keep this on in
# development: the same fixtures get reprocessed constantly and the free tier
# daily quota does not survive that.
# AI_CACHE_ENABLED=true
# AI_CACHE_DIR=.cache/ai

# In-memory session lifetime and page image storage.
# SESSION_TTL_MS=3600000
# FILE_STORE_DIR=.data/files

# LOG_LEVEL=debug

# AI_THINKING_BUDGET=0

# --- Key pool ---
# Several keys are pooled and rotated round-robin. A key that reports 429 or
# 403 is sidelined for a cooldown and traffic moves to the next one, which
# raises the effective free-tier ceiling and makes quota exhaustion survivable.
# Any of these three shapes works; numbered keys are read in numeric order.
#   GEMINI_API_KEY=single-key
#   GEMINI_API_KEYS=key-one,key-two
#   GEMINI_API_KEY_1=key-one
#   GEMINI_API_KEY_2=key-two
# GEMINI_KEY_COOLDOWN_MS=65000
